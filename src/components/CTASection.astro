---
import CTAButton from './CTAButton.astro';

interface Props {
  title: string;
  subtitle: string;
  backgroundImage?: string;
  primaryCTA: {
    text: string;
    to?: string;
    href?: string;
    variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'light' | 'light-outline';
  };
  secondaryCTA?: {
    text: string;
    to?: string;
    href?: string;
    variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'light' | 'light-outline';
  };
  class?: string;
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '4xl';
}

const {
  title,
  subtitle,
  backgroundImage = '/images/financial-planning.jpg',
  primaryCTA,
  secondaryCTA,
  class: className = '',
  maxWidth = '4xl',
} = Astro.props;

const maxWidthClasses = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
  '2xl': 'max-w-2xl',
  '4xl': 'max-w-4xl',
};
---

<section
  class={`py-20 bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 relative overflow-hidden ${className}`}
>
  {/* Background Image */}
  <div class="absolute inset-0">
    <img
      src={backgroundImage}
      alt="Call to action background"
      class="w-full h-full object-cover opacity-20"
    />
  </div>

  {/* Enhanced Gradient Overlay */}
  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-blue-900/60 to-indigo-900/40"></div>

  {/* Decorative Elements */}
  <div class="absolute top-10 right-10 w-32 h-32 bg-white/5 rounded-full blur-xl"></div>
  <div class="absolute bottom-10 left-10 w-24 h-24 bg-blue-400/10 rounded-full blur-lg"></div>
  <div class="absolute top-1/2 left-1/4 w-16 h-16 bg-indigo-400/10 rounded-full blur-md"></div>

  {/* Content Container */}
  <div class={`${maxWidthClasses[maxWidth]} mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10`}>
    <div>
      {/* Main Heading */}
      <h2 class="text-3xl md:text-4xl font-ubuntu font-bold text-white mb-6 drop-shadow-lg">
        {title}
      </h2>

      {/* Subtitle */}
      <p class="text-xl text-blue-50 mb-8 mx-auto leading-relaxed drop-shadow-md">
        {subtitle}
      </p>

      {/* Action Buttons */}
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <CTAButton
          to={primaryCTA.to || primaryCTA.href || '#'}
          variant={primaryCTA.variant || 'light'}
          size="lg"
        >
          {primaryCTA.text}
        </CTAButton>

        {secondaryCTA && (
          <CTAButton
            to={secondaryCTA.to || secondaryCTA.href || '#'}
            variant={secondaryCTA.variant || 'light-outline'}
            size="lg"
          >
            {secondaryCTA.text}
          </CTAButton>
        )}
      </div>
    </div>
  </div>
</section>
