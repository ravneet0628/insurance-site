---
import { Icon } from 'astro-icon/components';
import CTAButton from './CTAButton.astro';

interface CTAProps {
  text: string;
  link?: string;
  scrollTo?: string;
}

interface Props {
  title: string;
  subtitle: string;
  bgImg?: string;
  primaryCTA?: CTAProps;
  secondaryCTA?: CTAProps;
  height?: 'sm' | 'md' | 'lg' | 'xl';
  overlay?: 'light' | 'medium' | 'heavy';
}

const {
  title,
  subtitle,
  bgImg,
  primaryCTA,
  secondaryCTA,
  height = 'lg',
  overlay = 'medium',
} = Astro.props;

const heightClasses = {
  sm: 'min-h-[400px] h-80 sm:h-96',
  md: 'min-h-[500px] h-96 sm:h-[500px]',
  lg: 'min-h-[680px] h-[500px] sm:h-[600px] lg:h-[680px]',
  xl: 'min-h-screen h-screen',
};

const overlayClasses = {
  light: 'rgba(30, 42, 120, 0.5)',
  medium: 'rgba(30, 42, 120, 0.7)',
  heavy: 'rgba(30, 42, 120, 0.85)',
};

const backgroundStyle = bgImg
  ? `linear-gradient(${overlayClasses[overlay]}, ${overlayClasses[overlay]}), url(${bgImg})`
  : 'linear-gradient(135deg, rgb(97, 107, 172) 0%, #2563eb 50%, #1e40af 100%)';

const hasCtaButtons = primaryCTA || secondaryCTA;
---

<section
  class={`relative flex flex-col items-center justify-center text-white ${heightClasses[height]} overflow-hidden ${bgImg ? 'bg-fixed md:bg-fixed bg-scroll' : ''}`}
  style={{
    backgroundImage: bgImg ? backgroundStyle : undefined,
    background: bgImg ? undefined : backgroundStyle,
    backgroundSize: bgImg ? 'cover' : undefined,
    backgroundPosition: bgImg ? 'center' : undefined,
    backgroundRepeat: bgImg ? 'no-repeat' : undefined,
  }}
  role="banner"
>
  {/* Enhanced overlay stack with proper z-indexing */}
  <div class="absolute inset-0 bg-black/10 z-10"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/20 z-20"></div>

  {/* Decorative elements - hidden on small screens */}
  <div class="absolute top-4 right-4 sm:top-10 sm:right-10 w-16 h-16 sm:w-32 sm:h-32 bg-white/5 rounded-full animate-pulse hidden sm:block z-0"></div>
  <div
    class="absolute bottom-16 left-4 sm:bottom-20 sm:left-10 w-12 h-12 sm:w-20 sm:h-20 bg-white/5 rounded-full animate-pulse hidden sm:block z-0"
    style="animation-delay: 1s;"
  ></div>

  {/* Main content container */}
  <div class="relative z-30 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex-1 flex flex-col justify-center">
    <div class="w-full space-y-6 sm:space-y-8 lg:space-y-10">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-ubuntu font-bold leading-tight sm:leading-tight md:leading-tight break-words">
        {title}
      </h1>

      <p class="text-base sm:text-lg md:text-xl lg:text-2xl text-gray-200 max-w-4xl mx-auto leading-relaxed font-light break-words px-2 sm:px-0 opacity-90">
        {subtitle}
      </p>

      {hasCtaButtons && (
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4 w-full max-w-lg mx-auto px-4 sm:px-0">
          {primaryCTA && (
            <CTAButton
              href={primaryCTA.scrollTo ? `#${primaryCTA.scrollTo}` : primaryCTA.link}
              variant="light"
              class="w-full sm:w-auto sm:min-w-[200px] lg:min-w-[220px]"
            >
              {primaryCTA.text}
            </CTAButton>
          )}
          {secondaryCTA && (
            <CTAButton
              href={secondaryCTA.scrollTo ? `#${secondaryCTA.scrollTo}` : secondaryCTA.link}
              variant="primary"
              class="w-full sm:w-auto sm:min-w-[200px] lg:min-w-[220px]"
            >
              {secondaryCTA.text}
            </CTAButton>
          )}
        </div>
      )}
    </div>
  </div>

  {height !== 'sm' && (
    <div class="absolute bottom-6 sm:bottom-8 lg:bottom-10 left-1/2 -translate-x-1/2 z-30">
      <div class="animate-bounce">
        <Icon name="lucide:chevron-down" class="w-8 h-8 sm:w-10 sm:h-10 text-white/70" />
      </div>
    </div>
  )}
</section>
