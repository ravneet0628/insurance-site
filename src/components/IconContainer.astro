---
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string | any;
  variant?: 'gradient' | 'solid' | 'soft' | 'outline' | 'none';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  color?: 'primary' | 'secondary' | 'success' | 'warning' | 'error';
  class?: string;
  iconClass?: string;
}

const {
  icon,
  variant = 'gradient',
  size = 'lg',
  color = 'primary',
  class: className = '',
  iconClass = '',
} = Astro.props;

// Convert PascalCase icon names (e.g., HeartHandshake) to kebab-case (e.g., heart-handshake)
const getIconName = (name: string) => {
  if (typeof name !== 'string') return 'shield';
  const kebab = name.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase();
  return `lucide:${kebab}`;
};

const iconName = typeof icon === 'string' ? getIconName(icon) : 'lucide:shield';

const sizeClasses = {
  sm: { container: 'w-12 h-12', icon: 'w-6 h-6' },
  md: { container: 'w-16 h-16', icon: 'w-8 h-8' },
  lg: { container: 'w-20 h-20', icon: 'w-10 h-10' },
  xl: { container: 'w-24 h-24', icon: 'w-12 h-12' },
};

const colorSchemes = {
  primary: {
    gradient: 'from-primary to-blue-600',
    solid: 'bg-primary',
    soft: 'from-primary/10 to-blue-100',
    outline: 'border-primary text-primary',
  },
  secondary: {
    gradient: 'from-gray-600 to-gray-800',
    solid: 'bg-gray-600',
    soft: 'from-gray-100 to-gray-200',
    outline: 'border-gray-600 text-gray-600',
  },
  success: {
    gradient: 'from-green-500 to-green-700',
    solid: 'bg-green-500',
    soft: 'from-green-100 to-green-200',
    outline: 'border-green-500 text-green-500',
  },
  warning: {
    gradient: 'from-yellow-500 to-orange-500',
    solid: 'bg-yellow-500',
    soft: 'from-yellow-100 to-orange-100',
    outline: 'border-yellow-500 text-yellow-500',
  },
  error: {
    gradient: 'from-red-500 to-red-700',
    solid: 'bg-red-500',
    soft: 'from-red-100 to-red-200',
    outline: 'border-red-500 text-red-500',
  },
};

const scheme = colorSchemes[color];
const baseContainerClasses = 'flex items-center justify-center rounded-2xl';
const hoverClasses = 'group-hover:scale-110 transition-transform duration-300 will-change-transform';

let containerStyleClasses = '';
if (variant === 'gradient') {
  containerStyleClasses = `${baseContainerClasses} bg-gradient-to-br ${scheme.gradient} ${hoverClasses}`;
} else if (variant === 'solid') {
  containerStyleClasses = `${baseContainerClasses} ${scheme.solid} ${hoverClasses}`;
} else if (variant === 'soft') {
  containerStyleClasses = `${baseContainerClasses} bg-gradient-to-br ${scheme.soft} ${hoverClasses}`;
} else if (variant === 'outline') {
  containerStyleClasses = `${baseContainerClasses} border-2 ${scheme.outline} bg-transparent ${hoverClasses}`;
} else if (variant === 'none') {
  containerStyleClasses = `flex items-center justify-start ${hoverClasses}`;
}

let iconColorClasses = 'text-white';
if (variant === 'soft') {
  iconColorClasses = color === 'primary' ? 'text-primary' : color === 'secondary' ? 'text-gray-600' : `text-${color}-600`;
} else if (variant === 'outline' || variant === 'none') {
  iconColorClasses = color === 'primary' ? 'text-primary' : color === 'secondary' ? 'text-gray-600' : `text-${color}-500`;
}

const containerSize = sizeClasses[size].container;
const iconSize = sizeClasses[size].icon;
---

{
  variant === 'none' ? (
    <div class={`${containerStyleClasses} ${className}`}>
      <Icon name={iconName} class={`${iconSize} ${iconColorClasses} ${iconClass}`} />
    </div>
  ) : (
    <div class={`${containerSize} ${containerStyleClasses} ${className}`}>
      <Icon name={iconName} class={`${iconSize} ${iconColorClasses} ${iconClass}`} />
    </div>
  )
}
