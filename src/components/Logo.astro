---
import { Image } from 'astro:assets';
import logoBg from '../assets/logo-bg.jpg';
import logoTransparent from '../assets/logo-transparent.png';

interface Props {
  class?: string;
  iconOnly?: boolean;
  light?: boolean;
}

const { class: className = '', iconOnly = false, light = false } = Astro.props;
const logoSrc = light ? logoBg : logoTransparent;
---
<div class={`flex items-center ${className}`}>
  {/* Premium Logo Mark */}
  <Image
    src={logoSrc}
    alt=""
    class="w-9 h-9 mr-3 object-contain rounded-lg"
    width={36}
    height={36}
    format="webp"
    quality={82}
    loading="eager"
    decoding="async"
    aria-hidden="true"
  />

  {!iconOnly && (
    <span
      class={`text-2xl font-ubuntu font-bold tracking-tight ${
        light ? 'text-white' : 'text-primary'
      }`}
    >
      Top Trust
    </span>
  )}
</div>
