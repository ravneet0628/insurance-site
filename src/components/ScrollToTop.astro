---
import { Icon } from 'astro-icon/components';
---

<button
  id="scroll-to-top"
  class="fixed bottom-8 right-8 z-50 bg-primary hover:bg-primary/90 text-white p-3 rounded-full shadow-lg transition-all duration-300 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 hidden opacity-0 translate-y-4"
  aria-label="Scroll to top"
>
  <Icon name="lucide:chevron-up" class="w-6 h-6" />
</button>

<script>
  const btn = document.getElementById('scroll-to-top');

  if (btn) {
    let isVisible = false;
    let ticking = false;

    const updateVisibility = () => {
      const shouldShow = window.scrollY > 400;
      ticking = false;

      if (shouldShow === isVisible) {
        return;
      }

      isVisible = shouldShow;
      if (shouldShow) {
        btn.classList.remove('hidden');
        requestAnimationFrame(() => {
          btn.classList.toggle('opacity-0', !isVisible);
          btn.classList.toggle('translate-y-4', !isVisible);
          btn.classList.toggle('opacity-100', isVisible);
          btn.classList.toggle('translate-y-0', isVisible);
        });
      } else {
        btn.classList.remove('opacity-100', 'translate-y-0');
        btn.classList.add('opacity-0', 'translate-y-4');
        setTimeout(() => {
          if (!isVisible) {
            btn.classList.add('hidden');
          }
        }, 300);
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateVisibility);
        }
      },
      { passive: true }
    );

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  }
</script>
