---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import Card from '../../components/Card.astro';
import CTAButton from '../../components/CTAButton.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import { allServicesContent } from '../../content/data/services';
import criticalIllnessService from '../../assets/images/service-critical-illness.png';
import disabilityService from '../../assets/images/service-disability.png';
import fhsaService from '../../assets/images/service-fhsa.png';
import lifeService from '../../assets/images/service-life.png';
import professionalConsultation from '../../assets/images/professional-consultation.jpg';
import respService from '../../assets/images/service-resp.png';
import rrspService from '../../assets/images/service-rrsp.png';
import superVisaService from '../../assets/images/service-super-visa.png';
import tfsaService from '../../assets/images/service-tfsa.png';
import visitorsService from '../../assets/images/service-visitors.png';

export async function getStaticPaths() {
  return allServicesContent.map((service) => ({
    params: { serviceSlug: service.slug },
    props: { service },
  }));
}

const { serviceSlug } = Astro.params;
const { service } = Astro.props;

const serviceIconMap: Record<string, string> = {
  'super-visa-insurance': 'ShieldCheck',
  'visitors-insurance': 'Plane',
  'life-insurance': 'HeartHandshake',
  'disability-insurance': 'UserCheck',
  'critical-illness-insurance': 'Heart',
  'resp': 'BookOpen',
  'rrsp': 'PiggyBank',
  'tfsa': 'ArrowUpRight',
  'fhsa': 'Home',
};

const iconName = serviceIconMap[serviceSlug] || 'Shield';
const optimizedImageMap = {
  '/images/professional-consultation.jpg': professionalConsultation,
  '/images/service-critical-illness.png': criticalIllnessService,
  '/images/service-disability.png': disabilityService,
  '/images/service-fhsa.png': fhsaService,
  '/images/service-life.png': lifeService,
  '/images/service-resp.png': respService,
  '/images/service-rrsp.png': rrspService,
  '/images/service-super-visa.png': superVisaService,
  '/images/service-tfsa.png': tfsaService,
  '/images/service-visitors.png': visitorsService,
};
const heroImagePath = service.hero.backgroundImage || '/images/professional-consultation.jpg';
const heroImage =
  optimizedImageMap[heroImagePath as keyof typeof optimizedImageMap] || professionalConsultation;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://toptrustinsurance.ca/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://toptrustinsurance.ca/#services-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.hero.title,
      "item": `https://toptrustinsurance.ca/services/${serviceSlug}`
    }
  ]
};
---

<Layout
  title={service.meta.title}
  description={service.meta.description}
  keywords={service.meta.keywords}
  canonical={`https://toptrustinsurance.ca/services/${serviceSlug}`}
  schema={schema}
>
  <main class="flex-grow">
    {/* Enhanced Hero Section */}
    <section class="relative overflow-hidden bg-gradient-to-br from-primary via-blue-600 to-blue-700 py-20 md:py-28">

      {/* Content */}
      <PageContainer background="none" class="relative z-10">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
          {/* Text Content */}
          <div class="text-white">
            <div class="flex items-center mb-4">
              <div class="h-1 w-12 bg-white mr-4"></div>
              <span class="text-blue-100 font-semibold uppercase tracking-wider text-sm">
                Insurance Service
              </span>
            </div>

            <h1 class="text-4xl md:text-6xl font-ubuntu font-bold mb-6 leading-tight">
              {service.hero.title}
            </h1>

            <p class="text-xl md:text-2xl text-blue-100 mb-8 leading-relaxed">
              {service.hero.subtitle}
            </p>

            <div class="flex flex-col gap-4 sm:flex-row">
              <CTAButton href={service.hero.ctaLink} variant="light" size="lg">
                {service.hero.ctaText}
              </CTAButton>
              <CTAButton href="/contact" variant="light-outline" size="lg">
                <Icon name="lucide:phone" class="w-5 h-5 mr-2" />
                Get Expert Advice
              </CTAButton>
            </div>
          </div>

          {/* Service Image */}
          <div class="relative">
            <div class="relative overflow-hidden rounded-2xl border border-white/20 bg-white/10 shadow-2xl">
              <Image
                src={heroImage}
                alt={`${service.hero.title} coverage and planning`}
                class="h-64 w-full object-cover sm:h-80 lg:h-[430px]"
                widths={[480, 768, 1024]}
                sizes="(min-width: 1024px) 42vw, 100vw"
                width={1024}
                format="webp"
                quality={82}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary/30 via-transparent to-transparent"></div>
              <div class="absolute left-5 top-5 flex h-14 w-14 items-center justify-center rounded-full bg-white shadow-xl">
                <Icon name={`lucide:${iconName.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase()}`} class="h-7 w-7 text-primary" />
              </div>
            </div>
          </div>
        </div>
      </PageContainer>
    </section>

    {/* Overview Section */}
    <section class="bg-white py-16 md:py-20">
      <PageContainer>
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_420px] lg:gap-16">
          <div>
            <div class="flex items-center mb-6">
              <div class="h-1 w-12 bg-primary mr-4"></div>
              <span class="text-primary font-semibold uppercase tracking-wider text-sm">
                Service Overview
              </span>
            </div>

            <h2 class="mb-6 max-w-3xl text-3xl font-ubuntu font-bold leading-tight text-neutral-text md:text-5xl">
              {service.overview.title}
            </h2>

            <p class="max-w-3xl text-lg leading-relaxed text-gray-600">
              {service.overview.content}
            </p>
          </div>

          {service.overview.highlights && (
            <aside class="rounded-2xl border border-blue-100 bg-blue-50/60 p-6 shadow-sm">
              <div class="mb-5 flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary text-white">
                  <Icon name={`lucide:${iconName.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase()}`} class="h-5 w-5" />
                </div>
                <h3 class="font-ubuntu text-xl font-bold text-neutral-text">At a glance</h3>
              </div>
              <ul class="space-y-4">
                {service.overview.highlights.map((highlight) => (
                  <li class="flex items-start gap-3">
                    <Icon name="lucide:check-circle-2" class="mt-0.5 h-5 w-5 flex-shrink-0 text-primary" />
                    <span class="font-medium leading-relaxed text-gray-700">{highlight}</span>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>
      </PageContainer>
    </section>

    {/* Features Section */}
    <section class="bg-gradient-to-br from-gray-50 to-white py-16 md:py-20">
      <PageContainer background="none">
        <div class="mb-12 max-w-3xl">
          <div class="mb-4 flex items-center">
            <div class="mr-4 h-1 w-12 bg-primary"></div>
            <span class="text-primary font-semibold uppercase tracking-wider text-sm">
              Key Features
            </span>
          </div>
          <h2 class="mb-5 text-3xl font-ubuntu font-bold text-neutral-text md:text-5xl">
            {service.features.title}
          </h2>
          {service.features.subtitle && (
            <p class="text-lg leading-relaxed text-gray-600">
              {service.features.subtitle}
            </p>
          )}
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {service.features.features.map((feature) => (
            <div class="group">
              <Card hover={false} class="relative h-full overflow-hidden border border-gray-100 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                <div class="relative z-10">
                  <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <Icon name={`lucide:${feature.icon.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase()}`} class="h-6 w-6" />
                  </div>

                  <h3 class="mb-3 text-xl font-ubuntu font-bold text-neutral-text">
                    {feature.title}
                  </h3>

                  <p class="mb-6 leading-relaxed text-gray-600">{feature.description}</p>

                  {feature.details && (
                    <ul class="space-y-3">
                      {feature.details.map((detail) => (
                        <li class="flex items-start">
                          <Icon name="lucide:check" class="mt-1 mr-3 h-4 w-4 flex-shrink-0 text-primary" />
                          <span class="text-sm text-gray-600">{detail}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </Card>
            </div>
          ))}
        </div>
      </PageContainer>
    </section>

    {/* Details Section */}
    <section class="bg-white py-16 md:py-20">
      <PageContainer>
        <div class="mb-12 max-w-4xl">
          <div class="mb-4 flex items-center">
            <div class="mr-4 h-1 w-12 bg-primary"></div>
            <span class="text-primary font-semibold uppercase tracking-wider text-sm">
              Detailed Information
            </span>
          </div>
          <h2 class="mb-5 text-3xl font-ubuntu font-bold text-neutral-text md:text-5xl">
            {service.details.title}
          </h2>
          <p class="text-lg leading-relaxed text-gray-600">
            {service.details.content}
          </p>
        </div>

        {service.details.items && (
          <div class="divide-y divide-gray-200 rounded-2xl border border-gray-200 bg-white">
            {service.details.items.map((item) => (
              <article class="grid gap-6 p-6 md:grid-cols-[280px_minmax(0,1fr)] md:p-8">
                <div>
                  <h3 class="mb-3 text-2xl font-ubuntu font-bold text-neutral-text">
                    {item.title}
                  </h3>
                  <p class="leading-relaxed text-gray-600">{item.description}</p>
                </div>

                {item.benefits && (
                  <ul class="grid gap-3 sm:grid-cols-2">
                    {item.benefits.map((benefit) => (
                      <li class="flex items-start rounded-lg bg-gray-50 p-3">
                        <Icon name="lucide:arrow-right" class="mt-0.5 mr-3 h-4 w-4 flex-shrink-0 text-primary" />
                        <span class="text-sm leading-relaxed text-gray-700">{benefit}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        )}
      </PageContainer>
    </section>

    {/* Enhanced CTA Section */}
    <section class="bg-gradient-to-br from-primary via-blue-600 to-blue-700 py-16 text-white md:py-20">
      <PageContainer background="none">
        <div class="mx-auto max-w-4xl text-center">
          <h2 class="mb-5 text-3xl font-ubuntu font-bold md:text-5xl">{service.cta.title}</h2>
          <p class="mx-auto mb-8 max-w-3xl text-lg leading-relaxed text-blue-50 md:text-xl">
            {service.cta.subtitle}
          </p>
          <div class="flex flex-col justify-center gap-4 sm:flex-row">
            <CTAButton href={service.cta.buttonLink} variant="light" size="lg">
              {service.cta.buttonText}
            </CTAButton>
            <CTAButton href="/resources" variant="light-outline" size="lg">
              Learn More
            </CTAButton>
          </div>
        </div>
      </PageContainer>
    </section>
  </main>

  <ScrollToTop />
</Layout>
