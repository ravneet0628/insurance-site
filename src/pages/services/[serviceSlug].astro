---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/PageContainer.astro';
import Card from '../../components/Card.astro';
import CTAButton from '../../components/CTAButton.astro';
import CTASection from '../../components/CTASection.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import { allServicesContent } from '../../content/data/services';

export async function getStaticPaths() {
  return allServicesContent.map((service) => ({
    params: { serviceSlug: service.slug },
    props: { service },
  }));
}

const { serviceSlug } = Astro.params;
const { service } = Astro.props;

const serviceIconMap: Record<string, string> = {
  'super-visa-insurance': 'ShieldCheck',
  'visitors-insurance': 'Plane',
  'life-insurance': 'HeartHandshake',
  'disability-insurance': 'UserCheck',
  'critical-illness-insurance': 'Heart',
  'resp': 'BookOpen',
  'rrsp': 'PiggyBank',
  'tfsa': 'ArrowUpRight',
  'fhsa': 'Home',
};

const serviceImageMap: Record<string, string> = {
  'life-insurance': '/images/life-protection.jpg',
  'super-visa-insurance': '/images/travel-insurance.jpg',
  'visitors-insurance': '/images/travel-insurance.jpg',
  'disability-insurance': '/images/professional-consultation.jpg',
  'critical-illness-insurance': '/images/critical-care.jpg',
  'resp': '/images/education-savings.jpg',
  'rrsp': '/images/investment-growth.jpg',
  'tfsa': '/images/investment-growth.jpg',
  'fhsa': '/images/investment-growth.jpg',
};

const iconName = serviceIconMap[serviceSlug] || 'Shield';
const serviceImage = serviceImageMap[serviceSlug] || '/images/professional-consultation.jpg';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://toptrustinsurance.ca/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://toptrustinsurance.ca/#services-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.hero.title,
      "item": `https://toptrustinsurance.ca/services/${serviceSlug}`
    }
  ]
};
---

<Layout
  title={service.meta.title}
  description={service.meta.description}
  keywords={service.meta.keywords}
  canonical={`https://toptrustinsurance.ca/services/${serviceSlug}`}
  schema={schema}
>
  <main class="flex-grow">
    {/* Enhanced Hero Section */}
    <section class="relative py-24 md:py-32 bg-gradient-to-br from-primary to-blue-600 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0">
        <img
          src={service.hero.backgroundImage || serviceImage}
          alt={`${service.hero.title} background`}
          class="w-full h-full object-cover opacity-20"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-primary/90 to-blue-600/90"></div>
      </div>

      {/* Content */}
      <PageContainer class="relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          {/* Text Content */}
          <div class="text-white">
            <div class="flex items-center mb-4">
              <div class="h-1 w-12 bg-white mr-4"></div>
              <span class="text-blue-100 font-semibold uppercase tracking-wider text-sm">
                Insurance Service
              </span>
            </div>

            <h1 class="text-4xl md:text-6xl font-ubuntu font-bold mb-6 leading-tight">
              {service.hero.title}
            </h1>

            <p class="text-xl md:text-2xl text-blue-100 mb-8 leading-relaxed">
              {service.hero.subtitle}
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <CTAButton href={service.hero.ctaLink} variant="light" size="lg">
                {service.hero.ctaText}
              </CTAButton>
              <CTAButton href="/contact" variant="light-outline" size="lg">
                <Icon name="lucide:phone" class="w-5 h-5 mr-2" />
                Get Expert Advice
              </CTAButton>
            </div>
          </div>

          {/* Visual Element */}
          <div class="hidden lg:block">
            <div class="relative flex justify-center">
              <div class="w-96 h-96 bg-white/10 rounded-full border border-white/20 flex items-center justify-center">
                <div class="w-64 h-64 bg-white/20 rounded-full border border-white/20 flex items-center justify-center">
                  <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-xl">
                    <Icon name={`lucide:${iconName.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase()}`} class="w-16 h-16 text-primary" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </PageContainer>
    </section>

    {/* Overview Section */}
    <section class="py-20 bg-white">
      <PageContainer>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          {/* Content */}
          <div>
            <div class="flex items-center mb-6">
              <div class="h-1 w-12 bg-primary mr-4"></div>
              <span class="text-primary font-semibold uppercase tracking-wider text-sm">
                Service Overview
              </span>
            </div>

            <h2 class="text-4xl md:text-5xl font-ubuntu font-bold text-neutral-text mb-8 leading-tight">
              {service.overview.title}
            </h2>

            <p class="text-lg text-gray-600 mb-8 leading-relaxed">
              {service.overview.content}
            </p>

            {service.overview.highlights && (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                {service.overview.highlights.map((highlight) => (
                  <div class="flex items-center p-4 bg-gray-50 rounded-lg">
                    <Icon name="lucide:check-circle-2" class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" />
                    <span class="text-gray-700 font-medium">{highlight}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Image */}
          <div class="relative">
            <div class="rounded-2xl overflow-hidden shadow-2xl">
              <img
                src={serviceImage}
                alt={`${service.overview.title} consultation and planning`}
                class="w-full h-[400px] object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent"></div>
            </div>

            {/* Floating Stats */}
            <div class="absolute -bottom-6 -left-6 bg-white p-6 rounded-xl shadow-xl border">
              <div class="flex items-center space-x-4">
                <div class="text-center">
                  <div class="text-2xl font-bold text-primary">24/7</div>
                  <div class="text-sm text-gray-600">Support</div>
                </div>
                <div class="h-8 w-px bg-gray-200"></div>
                <div class="text-center">
                  <div class="text-2xl font-bold text-primary">100%</div>
                  <div class="text-sm text-gray-600">Satisfaction</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </PageContainer>
    </section>

    {/* Features Section */}
    <section class="py-20 bg-gradient-to-br from-gray-50 to-white">
      <PageContainer>
        <div class="text-center mb-16">
          <div class="flex items-center justify-center mb-4">
            <Icon name="lucide:star" class="w-6 h-6 text-primary mr-2" />
            <span class="text-primary font-semibold uppercase tracking-wider text-sm">
              Key Features
            </span>
            <Icon name="lucide:star" class="w-6 h-6 text-primary ml-2" />
          </div>
          <h2 class="text-4xl md:text-5xl font-ubuntu font-bold text-neutral-text mb-6">
            {service.features.title}
          </h2>
          {service.features.subtitle && (
            <p class="text-lg text-gray-600 max-w-3xl mx-auto">
              {service.features.subtitle}
            </p>
          )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {service.features.features.map((feature) => (
            <div class="group">
              <Card class="h-full p-8 hover:shadow-xl transition-all duration-500 hover:-translate-y-2 bg-white border-0 relative overflow-hidden">
                {/* Background Pattern */}
                <div class="absolute top-0 right-0 w-20 h-20 bg-primary/5 rounded-full -mr-10 -mt-10 group-hover:scale-150 transition-transform duration-500"></div>

                <div class="relative z-10">
                  {/* Enhanced Icon */}
                  <div class="w-16 h-16 bg-gradient-to-br from-primary to-blue-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
                    <Icon name={`lucide:${feature.icon.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase()}`} class="w-8 h-8 text-white" />
                  </div>

                  <h3 class="text-xl font-ubuntu font-bold text-neutral-text mb-4">
                    {feature.title}
                  </h3>

                  <p class="text-gray-600 mb-6 leading-relaxed">{feature.description}</p>

                  {feature.details && (
                    <ul class="space-y-3">
                      {feature.details.map((detail) => (
                        <li class="flex items-start">
                          <Icon name="lucide:check-circle-2" class="w-4 h-4 text-green-500 mt-0.5 mr-3 flex-shrink-0" />
                          <span class="text-sm text-gray-600">{detail}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </Card>
            </div>
          ))}
        </div>
      </PageContainer>
    </section>

    {/* Details Section */}
    <section class="py-20 bg-white">
      <PageContainer>
        <div class="text-center mb-16">
          <div class="flex items-center justify-center mb-4">
            <Icon name="lucide:info" class="w-6 h-6 text-primary mr-2" />
            <span class="text-primary font-semibold uppercase tracking-wider text-sm">
              Detailed Information
            </span>
            <Icon name="lucide:info" class="w-6 h-6 text-primary ml-2" />
          </div>
          <h2 class="text-4xl md:text-5xl font-ubuntu font-bold text-neutral-text mb-6">
            {service.details.title}
          </h2>
          <p class="text-lg text-gray-600 max-w-4xl mx-auto leading-relaxed">
            {service.details.content}
          </p>
        </div>

        {service.details.items && (
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            {service.details.items.map((item) => (
              <div class="group">
                <Card class="h-full p-8 bg-gradient-to-br from-gray-50 to-white hover:shadow-xl transition-all duration-500 hover:-translate-y-1">
                  <div class="mb-6">
                    <h3 class="text-2xl font-ubuntu font-bold text-neutral-text mb-4">
                      {item.title}
                    </h3>
                    <div class="w-12 h-1 bg-primary"></div>
                  </div>

                  <p class="text-gray-600 mb-6 leading-relaxed">{item.description}</p>

                  {item.benefits && (
                    <ul class="space-y-3">
                      {item.benefits.map((benefit) => (
                        <li class="flex items-start">
                          <Icon name="lucide:arrow-right" class="w-4 h-4 text-primary mt-0.5 mr-3 flex-shrink-0" />
                          <span class="text-sm text-gray-700">{benefit}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </Card>
              </div>
            ))}
          </div>
        )}
      </PageContainer>
    </section>

    {/* Enhanced CTA Section */}
    <CTASection
      title={service.cta.title}
      subtitle={service.cta.subtitle}
      backgroundImage="/images/financial-planning.jpg"
      primaryCTA={{
        text: 'Contact Us',
        href: '/contact',
      }}
      secondaryCTA={{
        text: 'Learn More',
        href: '/resources',
      }}
    />
  </main>

  <ScrollToTop />
</Layout>
